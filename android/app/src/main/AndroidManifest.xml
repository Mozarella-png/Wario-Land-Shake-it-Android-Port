<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030002" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.WarioShakeIt">

        <!-- The launcher: asks for the game's data zip the first time (or when asked to change it). -->
        <activity
            android:name=".SetupActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|keyboard|navigation"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game runs in its own process, so it can be restarted with another game folder. -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|keyboard|navigation"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
